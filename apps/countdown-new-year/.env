# Puerto HTTP de la aplicación
PORT=3000

# Zona horaria IANA usada para calcular Año Nuevo
# Ejemplos: America/Bogota, America/Mexico_City, America/Argentina/Buenos_Aires, Europe/Madrid, UTC
TIMEZONE=America/Bogota

# Colores del tema (hex, rgb(), hsl() o nombre CSS)
PRIMARY_COLOR=#7c3aed
SECONDARY_COLOR=#06b6d4
